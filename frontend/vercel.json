{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sustha-backend.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://sustha-backend.onrender.com/health/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
